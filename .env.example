# Local-only binding by default. Change to 0.0.0.0 only on a trusted network.
BIND_ADDRESS=127.0.0.1
PORT=8095

# Host folders used by the integrated application.
VOLLEY_DATA_HOST_PATH=./data
LABELS_HOST_PATH=./data
VIDEO_HOST_PATH=./data/videos
CALIBRATIONS_HOST_PATH=./data/calibrations
OUTPUT_HOST_PATH=./data/training
EXISTING_VIDEO_HOST_PATH=./data/existing-videos
EXISTING_MODEL_HOST_PATH=./data/existing-models

# Relative prefix written into calibration JSON video fields.
VIDEO_JSON_PREFIX=../
